# 배포 빌드 설정.
#
# API 주소를 비워 둔다. 그러면 프론트가 /api/... 같은 **상대경로**로 부르고,
# nginx 가 그 경로만 뒤쪽 uvicorn(127.0.0.1:8000) 으로 넘긴다.
# 브라우저 입장에서는 화면과 API 가 같은 오리진이라 CORS 설정 자체가 필요 없다.
#
# 지우면 기본값 http://localhost:8000 으로 돌아간다 — 배포본에서는
# 방문자 자기 PC 를 가리키게 되어 썸네일과 실행중 배너가 죽는다.
VITE_API_BASE=

# 데모(목업) 모드를 켠 채로 배포한다.
# 0 으로 바꾸면 A/B 테스트·설정·크레딧 화면이 전부 404 로 죽는다 —
# 그 엔드포인트들은 아직 서버에 없다.
VITE_MOCK=1

# 실행을 진짜 파이프라인에 맡기지 않는다.
#
# .env.production 은 .env.local 을 **덮어쓰지 않고 합친다.** 여기서 명시하지
# 않으면 로컬 개발자의 .env.local 에 있는 VITE_LIVE_RUN=1 이 그대로 배포
# 번들에 실려서, 방문자 브라우저가 있지도 않은 파이프라인을 부르게 된다.
# 배포본은 이미 돌려 둔 실행을 재생한다.
VITE_LIVE_RUN=0
